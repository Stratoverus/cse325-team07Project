@inject TaskDone.Services.SupabaseAuthService AuthService
@inject NavigationManager Navigation
@implements IDisposable

<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <ErrorBoundary>
            <ChildContent>
                <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
            </ChildContent>
            <ErrorContent Context="ex">
                <LayoutView Layout="typeof(Layout.MainLayout)">
                    <div class="alert alert-danger m-3" role="alert">
                        Page failed to render: @ex.Message
                    </div>
                </LayoutView>
            </ErrorContent>
        </ErrorBoundary>

        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

@code {
    private bool _sessionRestoreCompleted;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += HandleLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await EnsureAndValidateSessionAsync();
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }

    private async Task EnsureAndValidateSessionAsync()
    {
        if (!_sessionRestoreCompleted)
        {
            _sessionRestoreCompleted = await AuthService.EnsureSessionRestoredAsync();
            if (!_sessionRestoreCompleted)
            {
                StateHasChanged();
                return;
            }
        }

        var timedOut = await AuthService.CheckAndHandleInactivityTimeoutAsync();
        if (timedOut)
        {
            Navigation.NavigateTo("/login", forceLoad: false);
            return;
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(EnsureAndValidateSessionAsync);
    }
}
