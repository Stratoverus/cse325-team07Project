@page "/signup"
@rendermode InteractiveServer
@inject TaskDone.Services.SupabaseAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Sign Up</PageTitle>

<h3>Create account</h3>

<EditForm Model="this" OnValidSubmit="HandleSignupAsync" FormName="SignupForm">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="form-label">Email</label>
        <InputText @bind-Value="email" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Password</label>
        <InputText @bind-Value="password" type="password" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Confirm Password</label>
        <InputText @bind-Value="confirmPassword" type="password" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary" disabled="@isLoading">
        @(isLoading ? "Creating account..." : "Sign Up")
    </button>
</EditForm>

@if (!string.IsNullOrWhiteSpace(message))
{
    <p class="mt-3 @(isError ? "text-danger" : "text-success")">@message</p>
}

<p class="mt-3">
    Already have an account?
    <NavLink href="/login">Sign in</NavLink>
</p>

@code {
    private string email = string.Empty;
    private string password = string.Empty;
    private string confirmPassword = string.Empty;
    private string message = string.Empty;
    private bool isLoading;
    private bool isError;

    private async Task HandleSignupAsync()
    {
        message = string.Empty;
        isError = false;

        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            isError = true;
            message = "Email and password are required.";
            return;
        }

        if (!string.Equals(password, confirmPassword, StringComparison.Ordinal))
        {
            isError = true;
            message = "Passwords do not match.";
            return;
        }

        if (password.Length < 6)
        {
            isError = true;
            message = "Password must be at least 6 characters.";
            return;
        }

        isLoading = true;

        try
        {
            var result = await AuthService.SignUpWithPasswordAsync(email, password);

            if (!result.Succeeded)
            {
                isError = true;
                message = result.ErrorMessage;
                return;
            }

            if (AuthService.IsAuthenticated)
            {
                Navigation.NavigateTo(GetProfileUrl());
                return;
            }

            Navigation.NavigateTo($"/verify-email?email={Uri.EscapeDataString(email)}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetProfileUrl()
    {
        var userId = AuthService.CurrentUserId;
        return string.IsNullOrWhiteSpace(userId) ? "/profile" : $"/profile/{userId}";
    }
}
