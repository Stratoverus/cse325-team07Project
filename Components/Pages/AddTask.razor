@page "/add-task"
@rendermode InteractiveServer

@using System.Linq
@using TaskDone.Models
@using TaskDone.Services

@inject TaskService TaskService
@inject SupabaseAuthService AuthService
@inject UserProfileService UserProfileService
@inject RewardService RewardService

<h3>Add New Task</h3>

@if (!AuthService.IsAuthenticated)
{
    <div class="alert alert-warning" role="alert">
        Please <NavLink href="/login?returnUrl=%2Fadd-task">log in</NavLink> to add or view tasks.
    </div>
}
else if (currentProfile == null)
{
    <div class="alert alert-info" role="alert">
        Loading your profile...
    </div>
}
else if (string.IsNullOrWhiteSpace(familyId))
{
    <div class="alert alert-warning" role="alert">
        Unable to determine your family. Please update <NavLink href="/family-settings">Family Settings</NavLink>.
    </div>
}
else
{
    <EditForm Model="@newTask" OnValidSubmit="HandleValidSubmit" FormName="AddTaskForm">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Title</label>
            <InputText class="form-control" @bind-Value="newTask.Title" />
        </div>

        <div class="mb-3">
            <label class="form-label">Assigned To</label>
            <InputText class="form-control" @bind-Value="newTask.AssignedTo" />
        </div>

        <div class="mb-3">
            <label class="form-label">Due Date</label>
            <InputDate class="form-control" @bind-Value="newTask.DueDate" />
        </div>

        <div class="mb-3">
            <label class="form-label">Notes</label>
            <InputTextArea class="form-control" @bind-Value="newTask.Notes" rows="3" />
        </div>

        <div class="mb-3">
            <button type="submit" class="btn btn-primary">Add Task</button>
            <button type="button" class="btn btn-outline-secondary ms-2" @onclick="ClearForm">Clear Form</button>
            <span class="ms-3 text-success">@message</span>
        </div>
    </EditForm>

    <h4 class="mt-4">Current Family Tasks</h4>
    @if (!currentTasks.Any())
    {
        <div class="alert alert-secondary">No tasks have been added for your family yet.</div>
    }
    else
    {
        <table class="table table-sm table-striped">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Assigned</th>
                    <th>Due</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var task in currentTasks.OrderBy(t => t.DueDate))
                {
                    <tr>
                        <td>@task.Title</td>
                        <td>@task.AssignedTo</td>
                        <td>@task.DueDate?.ToShortDateString() ?? "No due date"</td>
                        <td>@(task.IsDone ? "Completed" : "Pending")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private TaskItem newTask = new() { DueDate = DateTime.Today };
    private string message = string.Empty;
    private List<TaskItem> currentTasks = new();
    private UserProfile? currentProfile;
    private string familyId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadTasksAsync();
    }

    private async Task LoadTasksAsync()
    {
        if (string.IsNullOrWhiteSpace(AuthService.CurrentUserId))
        {
            currentProfile = null;
            familyId = string.Empty;
            currentTasks = new List<TaskItem>();
            return;
        }

        var userId = AuthService.CurrentUserId;
        var token = AuthService.CurrentSession?.AccessToken ?? string.Empty;

        currentProfile = await UserProfileService.GetProfileAsync(userId, token);
        familyId = await RewardService.GetFamilyIdAsync(userId, token) ?? string.Empty;

        if (!string.IsNullOrWhiteSpace(familyId))
        {
            currentTasks = TaskService.GetTasksByFamilyId(familyId).ToList();
        }
        else
        {
            currentTasks = new List<TaskItem>();
        }
    }

    private async Task HandleValidSubmit()
    {
        if (string.IsNullOrWhiteSpace(newTask.Title))
        {
            message = "Title is required.";
            return;
        }

        if (newTask.DueDate < DateTime.Today)
        {
            message = "Due date must be today or later.";
            return;
        }

        if (string.IsNullOrWhiteSpace(familyId))
        {
            message = "Unable to determine family membership. Please join or create a family first.";
            return;
        }

        newTask.FamilyId = familyId;
        if (string.IsNullOrWhiteSpace(newTask.TaskId))
        {
            newTask.TaskId = Guid.NewGuid().ToString();
        }

        TaskService.AddTask(newTask);
        message = "Task added!";

        newTask = new TaskItem { DueDate = DateTime.Today, FamilyId = familyId };
        await LoadTasksAsync();
    }

    private void ClearForm()
    {
        newTask = new TaskItem { DueDate = DateTime.Today, FamilyId = familyId };
        message = string.Empty;
    }
}
