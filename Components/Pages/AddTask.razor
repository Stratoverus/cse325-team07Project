@page "/add-task"
@rendermode InteractiveServer

@using System.Linq
@using TaskDone.Models
@using TaskDone.Services

@inject TaskService TaskService
@inject SupabaseAuthService AuthService
@inject UserProfileService UserProfileService
@inject RewardService RewardService
@inject NavigationManager Navigation
@inject Supabase.Client SupabaseClient

<h3>Add New Task</h3>

@if (!AuthService.IsAuthenticated)
{
    <div class="alert alert-warning" role="alert">
        Please <NavLink href="/login?returnUrl=%2Fadd-task">log in</NavLink> to add or view tasks.
    </div>
}
else if (currentProfile == null)
{
    <div class="alert alert-info" role="alert">
        Loading your profile...
    </div>
}
else if (string.IsNullOrWhiteSpace(familyId))
{
    <div class="alert alert-warning" role="alert">
        Unable to determine your family. Please update <NavLink href="/family-settings">Family Settings</NavLink>.
    </div>
}
else
{
    <EditForm Model="@newTask" OnValidSubmit="HandleValidSubmit" FormName="AddTaskForm">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Title</label>
            <InputText class="form-control" @bind-Value="newTask.Title" />
        </div>

        <div class="mb-3">
            <label class="form-label">Assigned To</label>
            <InputSelect class="form-select" @bind-Value="selectedAssigneeUserId">
                <option value="">Select a family member</option>
                @foreach (var assignee in assigneeOptions)
                {
                    <option value="@assignee.UserId">@assignee.DisplayName</option>
                }
            </InputSelect>
        </div>

        <div class="mb-3">
            <label class="form-label">Due Date</label>
            <InputDate class="form-control" @bind-Value="newTask.DueDate" />
        </div>

        <div class="mb-3">
            <label class="form-label">Notes</label>
            <InputTextArea class="form-control" @bind-Value="newTask.Notes" rows="3" />
        </div>

        <div class="mb-3">
            <button type="submit" class="btn btn-primary">Add Task</button>
            <button type="button" class="btn btn-outline-secondary ms-2" @onclick="ClearForm">Clear Form</button>
            <button type="button" class="btn btn-outline-primary ms-2" @onclick="NavigateBackToDashboard">Back to Family Dashboard</button>
            <span class="ms-3 text-success">@message</span>
        </div>
    </EditForm>

    <h4 class="mt-4">Current Family Tasks</h4>
    @if (!currentTasks.Any())
    {
        <div class="alert alert-secondary">No tasks have been added for your family yet.</div>
    }
    else
    {
        <table class="table table-sm table-striped">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Assigned</th>
                    <th>Due</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var task in currentTasks.OrderBy(t => t.DueDate))
                {
                    <tr>
                        <td>@task.Title</td>
                        <td>@(task.AssignedToUserId != null ? (assigneeOptions.FirstOrDefault(a => a.UserId == task.AssignedToUserId)?.DisplayName ?? task.AssignedToUserId) : "Unassigned")</td>
                        <td>@(task.DueDate?.ToShortDateString() ?? "No due date")</td>
                        <td>@(task.IsDone ? "Completed" : "Pending")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private TaskItem newTask = new() { DueDate = DateTime.Today };
    private string message = string.Empty;
    private List<TaskItem> currentTasks = new();
    private UserProfile? currentProfile;
    private string familyId = string.Empty;
    private string? requestedFamilyId;
    private string selectedAssigneeUserId = string.Empty;
    private List<AssigneeOption> assigneeOptions = new();

    protected override async Task OnParametersSetAsync()
    {
        await AuthService.EnsureSessionRestoredAsync();
        requestedFamilyId = GetRequestedFamilyId();
        await LoadTasksAsync();
    }

    private async Task LoadTasksAsync()
    {
        if (string.IsNullOrWhiteSpace(AuthService.CurrentUserId))
        {
            currentProfile = null;
            familyId = string.Empty;
            currentTasks = new List<TaskItem>();
            assigneeOptions = new List<AssigneeOption>();
            selectedAssigneeUserId = string.Empty;
            return;
        }

        var userId = AuthService.CurrentUserId;
        var token = AuthService.CurrentSession?.AccessToken ?? string.Empty;

        if (!string.IsNullOrWhiteSpace(token))
        {
            try { await SupabaseClient.Auth.SetSession(token, AuthService.CurrentSession?.RefreshToken ?? string.Empty); } catch { }
        }

        currentProfile = await UserProfileService.GetProfileAsync(userId, token);
        var memberships = await RewardService.GetFamilyMembershipsAsync(userId, token);

        FamilyMember? selectedMembership = null;
        if (!string.IsNullOrWhiteSpace(requestedFamilyId))
        {
            selectedMembership = memberships.FirstOrDefault(m =>
                string.Equals(m.FamilyId, requestedFamilyId, StringComparison.Ordinal));
        }

        selectedMembership ??= memberships
            .OrderByDescending(m => m.JoinedAt)
            .FirstOrDefault();

        familyId = selectedMembership?.FamilyId ?? string.Empty;

        if (!string.IsNullOrWhiteSpace(familyId))
        {
            try
            {
                var result = await SupabaseClient.From<TaskItem>().Where(x => x.FamilyId == familyId).Get();
                currentTasks = result.Models;
            }
            catch
            {
                currentTasks = new List<TaskItem>();
            }
            await LoadAssigneeOptionsAsync(familyId, token);
        }
        else
        {
            currentTasks = new List<TaskItem>();
            assigneeOptions = new List<AssigneeOption>();
            selectedAssigneeUserId = string.Empty;
        }
    }

    private async Task HandleValidSubmit()
    {
        if (string.IsNullOrWhiteSpace(newTask.Title))
        {
            message = "Title is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(selectedAssigneeUserId))
        {
            message = "Please select a family member to assign this task to.";
            return;
        }

        if (newTask.DueDate < DateTime.Today)
        {
            message = "Due date must be today or later.";
            return;
        }

        if (string.IsNullOrWhiteSpace(familyId))
        {
            message = "Unable to determine family membership. Please join or create a family first.";
            return;
        }

        newTask.FamilyId = familyId;
        if (string.IsNullOrWhiteSpace(newTask.TaskId))
        {
            newTask.TaskId = Guid.NewGuid().ToString();
        }

        var selectedAssignee = assigneeOptions.FirstOrDefault(x =>
            string.Equals(x.UserId, selectedAssigneeUserId, StringComparison.Ordinal));

        if (selectedAssignee is null)
        {
            message = "Selected assignee is no longer available for this family.";
            return;
        }

        newTask.AssignedToUserId = selectedAssignee.UserId;
        newTask.CreatedByUserId = AuthService.CurrentUserId ?? string.Empty;
        
        var now = DateTime.UtcNow;
        newTask.CreatedAt = now;
        newTask.UpdatedAt = now;
        newTask.IsAccepted = false;

        try
        {
            await SupabaseClient.From<TaskItem>().Insert(newTask);
            
            message = "Task added!";

            newTask = new TaskItem { DueDate = DateTime.Today, FamilyId = familyId };
            await LoadTasksAsync();
        }
        catch (Exception ex)
        {
            message = $"Error adding task to DB: {ex.Message}";
        }
    }

    private void ClearForm()
    {
        newTask = new TaskItem { DueDate = DateTime.Today, FamilyId = familyId };
        selectedAssigneeUserId = string.Empty;
        message = string.Empty;
    }

    private void NavigateBackToDashboard()
    {
        if (string.IsNullOrWhiteSpace(familyId))
        {
            Navigation.NavigateTo("/dashboard");
            return;
        }

        Navigation.NavigateTo($"/dashboard?familyId={Uri.EscapeDataString(familyId)}");
    }

    private string? GetRequestedFamilyId()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (!query.TryGetValue("familyId", out var value) || string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        return value.ToString();
    }

    private async Task LoadAssigneeOptionsAsync(string selectedFamilyId, string accessToken)
    {
        assigneeOptions = new List<AssigneeOption>();
        selectedAssigneeUserId = string.Empty;

        var familyMembers = await RewardService.GetFamilyMembershipsByFamilyIdAsync(selectedFamilyId, accessToken);

        var uniqueMemberIds = familyMembers
            .Select(m => m.UserId)
            .Where(id => !string.IsNullOrWhiteSpace(id))
            .Distinct(StringComparer.Ordinal)
            .ToList();

        foreach (var memberUserId in uniqueMemberIds)
        {
            var profile = await UserProfileService.GetProfileAsync(memberUserId, accessToken);

            var displayName = profile is null
                ? memberUserId
                : !string.IsNullOrWhiteSpace(profile.PreferredDisplayName)
                    ? profile.PreferredDisplayName
                    : !string.IsNullOrWhiteSpace(profile.FullName)
                        ? profile.FullName
                        : profile.Email;

            assigneeOptions.Add(new AssigneeOption(memberUserId, displayName));
        }

        assigneeOptions = assigneeOptions
            .OrderBy(x => x.DisplayName)
            .ToList();

        if (assigneeOptions.Count == 1)
        {
            selectedAssigneeUserId = assigneeOptions[0].UserId;
        }
    }

    private sealed record AssigneeOption(string UserId, string DisplayName);
}
