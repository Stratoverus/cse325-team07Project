@page "/login"
@rendermode InteractiveServer
@inject TaskDone.Services.SupabaseAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Login</PageTitle>

<h3>Sign in</h3>

<EditForm Model="this" OnValidSubmit="HandleLoginAsync" FormName="LoginForm">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="form-label">Email</label>
        <InputText @bind-Value="email" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Password</label>
        <InputText @bind-Value="password" type="password" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary" disabled="@isLoading">
        @(isLoading ? "Signing in..." : "Login")
    </button>
</EditForm>

@if (!string.IsNullOrWhiteSpace(message))
{
    <p class="mt-3 text-danger">@message</p>
}

@code {
    string email = "";
    string password = "";
    string message = "";
    bool isLoading;
    string returnUrl = "/profile";

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("returnUrl", out var value) && !string.IsNullOrWhiteSpace(value))
        {
            returnUrl = value.ToString();
        }
    }

    async Task HandleLoginAsync()
    {
        message = string.Empty;

        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            message = "Please enter email and password.";
            return;
        }

        isLoading = true;

        try
        {
            var result = await AuthService.SignInWithPasswordAsync(email, password);

            if (!result.Succeeded)
            {
                message = result.ErrorMessage;
                return;
            }

            var targetUrl = ResolvePostLoginUrl();

            Navigation.NavigateTo(targetUrl);
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetProfileUrl()
    {
        var userId = AuthService.CurrentUserId;
        return string.IsNullOrWhiteSpace(userId) ? "/profile" : $"/profile/{userId}";
    }

    private string ResolvePostLoginUrl()
    {
        var normalized = NormalizeReturnUrl(returnUrl);

        if (normalized.StartsWith("/profile", StringComparison.OrdinalIgnoreCase))
        {
            return GetProfileUrl();
        }

        return normalized;
    }

    private static string NormalizeReturnUrl(string? rawUrl)
    {
        if (string.IsNullOrWhiteSpace(rawUrl))
        {
            return "/profile";
        }

        var url = rawUrl.Trim();

        if (!url.StartsWith('/') || url.StartsWith("//", StringComparison.Ordinal))
        {
            return "/profile";
        }

        return url;
    }
}

<p class="mt-3">
    Need an account?
    <NavLink href="/signup">Create one</NavLink>
</p>