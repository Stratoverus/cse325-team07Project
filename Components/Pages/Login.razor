@page "/login"
@rendermode InteractiveServer
@inject TaskDone.Services.SupabaseAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Login</PageTitle>

<section class="login-shell container">
    <div class="row justify-content-center w-100">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">
            <div class="login-card">
        <h3 class="login-title">Sign in</h3>

        <div class="mb-3">
            <button type="button" class="google-btn" @onclick="HandleGoogleSignInAsync" disabled="@isLoading">
                <img class="google-icon" src="https://developers.google.com/identity/images/g-logo.png" alt="Google logo" />
                Sign in with Google
            </button>
        </div>

        <div class="d-flex align-items-center mb-3">
            <hr class="flex-grow-1" />
            <span class="px-2 text-muted">or</span>
            <hr class="flex-grow-1" />
        </div>

        <EditForm Model="this" OnValidSubmit="HandleLoginAsync" FormName="LoginForm">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">Email</label>
                <InputText @bind-Value="email" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>
                <InputText @bind-Value="password" type="password" class="form-control" />
            </div>

            <button type="submit" class="btn btn-primary w-100" disabled="@isLoading">
                @(isLoading ? "Signing in..." : "Login")
            </button>
        </EditForm>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <p class="mt-3 text-danger">@message</p>
        }

                <p class="mt-3 mb-0 text-center">
                    Need an account?
                    <NavLink href="/signup">Create one</NavLink>
                </p>
            </div>
        </div>
    </div>
</section>

@code {
    string email = "";
    string password = "";
    string message = "";
    bool isLoading;
    string returnUrl = "/profile";
    bool sessionRestoreCompleted;

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("returnUrl", out var value) && !string.IsNullOrWhiteSpace(value))
        {
            returnUrl = value.ToString();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!sessionRestoreCompleted)
        {
            sessionRestoreCompleted = await AuthService.EnsureSessionRestoredAsync();

            if (!sessionRestoreCompleted)
            {
                StateHasChanged();
                return;
            }
        }

        if (AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo(ResolvePostLoginUrl(), forceLoad: false);
            return;
        }
    }

    async Task HandleLoginAsync()
    {
        message = string.Empty;

        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            message = "Please enter email and password.";
            return;
        }

        isLoading = true;

        try
        {
            var result = await AuthService.SignInWithPasswordAsync(email, password);

            if (!result.Succeeded)
            {
                message = result.ErrorMessage;
                return;
            }

            var targetUrl = ResolvePostLoginUrl();
            Navigation.NavigateTo(targetUrl, forceLoad: false);
        }
        catch (Exception ex)
        {
            message = $"Login failed unexpectedly: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    async Task HandleGoogleSignInAsync()
    {
        var redirectUrl = Navigation.ToAbsoluteUri("/").ToString().TrimEnd('/');
        var callbackUrl = $"{redirectUrl}/auth/callback";
        var oauthUrl = AuthService.GetOAuthSignInUrl("google", callbackUrl);
        
        if (!string.IsNullOrWhiteSpace(oauthUrl))
        {
            Navigation.NavigateTo(oauthUrl, forceLoad: true);
        }
        else
        {
            message = "Unable to initiate Google sign-in. Please check your configuration.";
        }
    }

    private string GetProfileUrl()
    {
        var userId = AuthService.CurrentUserId;
        return string.IsNullOrWhiteSpace(userId) ? "/profile" : $"/profile/{userId}";
    }

    private string ResolvePostLoginUrl()
    {
        var normalized = NormalizeReturnUrl(returnUrl);

        if (normalized.Equals("/login", StringComparison.OrdinalIgnoreCase) ||
            normalized.StartsWith("/login?", StringComparison.OrdinalIgnoreCase))
        {
            return GetProfileUrl();
        }

        if (normalized.StartsWith("/profile", StringComparison.OrdinalIgnoreCase))
        {
            return GetProfileUrl();
        }

        return normalized;
    }

    private static string NormalizeReturnUrl(string? rawUrl)
    {
        if (string.IsNullOrWhiteSpace(rawUrl))
        {
            return "/profile";
        }

        var url = rawUrl.Trim();

        if (!url.StartsWith('/') || url.StartsWith("//", StringComparison.Ordinal))
        {
            return "/profile";
        }

        return url;
    }
}
