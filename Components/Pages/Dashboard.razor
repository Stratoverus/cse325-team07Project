@page "/dashboard"
@rendermode InteractiveServer

@using System.Linq
@using TaskDone.Services
@using TaskDone.Models

@inject TaskService TaskService
@inject NavigationManager Navigation
@inject TaskDone.Services.SupabaseAuthService AuthService
@inject TaskDone.Services.UserProfileService UserProfileService

<h3>Dashboard</h3>

@if (!AuthService.IsAuthenticated)
{
    <div class="alert alert-warning" role="alert">
        Please <NavLink href="/login?returnUrl=%2Fdashboard">log in</NavLink> to view the dashboard.
    </div>
}
else
{
    <div class="mb-3">
        <NavLink class="btn btn-success" href="/add-task">Add New Task</NavLink>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="card text-white bg-primary mb-3">
                <div class="card-body">
                    <h5 class="card-title">Total Tasks</h5>
                    <p class="card-text">@visibleTasks.Count()</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-success mb-3">
                <div class="card-body">
                    <h5 class="card-title">Completed Tasks</h5>
                    <p class="card-text">@visibleTasks.Count(t => t.IsDone)</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-warning mb-3">
                <div class="card-body">
                    <h5 class="card-title">Pending Tasks</h5>
                    <p class="card-text">@visibleTasks.Count(t => !t.IsDone)</p>
                </div>
            </div>
        </div>
    </div>

    @if (currentProfile != null)
    {
        <div class="alert alert-info d-flex align-items-center justify-content-between mb-3">
            <span>Points balance: <strong>@currentProfile.PointsBalance pts</strong></span>
            <button class="btn btn-sm btn-warning" disabled>Redeem Points (coming soon)</button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(pointsMessage))
    {
        <div class="alert alert-success">@pointsMessage</div>
    }

    <h4>Recent Tasks</h4>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Title</th>
                <th>Assigned To</th>
                <th>Status</th>
                <th>Due Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var task in visibleTasks.OrderBy(t => t.DueDate))
            {
                <tr>
                    @if (editingTask == task)
                    {
                        <td>
                            <InputText class="form-control" @bind-Value="tempTask.Title" />
                        </td>
                        <td>
                            <InputText class="form-control" @bind-Value="tempTask.AssignedTo" />
                        </td>
                        <td>@(task.IsDone ? "Completed" : "Pending")</td>
                        <td>
                            <InputDate class="form-control" @bind-Value="tempTask.DueDate" />
                        </td>
                        <td>
                            <button class="btn btn-sm btn-success" @onclick="SaveEdit">Save</button>
                            <button class="btn btn-sm btn-secondary ms-2" @onclick="CancelEdit">Cancel</button>
                        </td>
                    }
                    else
                    {
                        <td>@task.Title</td>
                        <td>@task.AssignedTo</td>
                        <td>
                            @if (task.IsDone)
                            {
                                <span class="badge bg-success">Completed</span>
                            }
                            else if (task.AcceptedByChild)
                            {
                                <span class="badge bg-primary">In Progress</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Pending</span>
                            }
                        </td>
                        <td>@task.DueDate.ToShortDateString()</td>
                        <td>
                            @if (!task.AcceptedByChild)
                            {
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => AcceptTask(task)">
                                    Accept
                                </button>
                            }
                            else if (!task.IsDone)
                            {
                            <button class="btn btn-sm btn-outline-success" @onclick="() => MarkComplete(task)">
                                Mark Complete
                            </button>
                            <button class="btn btn-sm btn-outline-warning ms-2" @onclick="() => StartUpdateNotes(task)">
                                Update Notes
                            </button>
                            <button class="btn btn-sm btn-outline-primary ms-2" @onclick="() => StartEdit(task)">
                                Edit
                            </button>
                            <button class="btn btn-sm btn-outline-danger ms-2" @onclick="() => DeleteTask(task)">
                                Delete
                            </button>
                        }
                            else
                        {
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleDone(task)">
                                Re-open
                            </button>
                        }
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
@if (updatingNotesTask != null)
{
    <div class="card mt-3 border-warning">
        <div class="card-body">
            <h6 class="card-title">Update notes — @updatingNotesTask.Title</h6>
            <textarea class="form-control mb-2" rows="3" @bind="updatingNotesTask.Notes"
                      placeholder="Add a progress note..."></textarea>
            <button class="btn btn-sm btn-warning" @onclick="SaveNotes">Save Notes</button>
            <button class="btn btn-sm btn-secondary ms-2" @onclick="CancelNotes">Cancel</button>
        </div>
    </div>
}
}

@code {
    private TaskItem? editingTask = null;
    private TaskItem tempTask = new();
    private IEnumerable<TaskItem> visibleTasks = Enumerable.Empty<TaskItem>();
    private TaskItem? updatingNotesTask = null;
    private UserProfile? currentProfile = null;
    private string pointsMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        visibleTasks = TaskService.AllTasks;

        var userId = AuthService.CurrentUserId;
        var token = AuthService.CurrentSession?.AccessToken;

        if (!string.IsNullOrWhiteSpace(userId) && !string.IsNullOrWhiteSpace(token))
        {
            currentProfile = await UserProfileService.GetProfileAsync(userId, token);
        }
    }

    void AcceptTask(TaskItem task)
    {
        task.AcceptedByChild = true;
    }

    async Task MarkComplete(TaskItem task)
    {
        TaskService.ToggleDone(task);

        if (task.IsDone && currentProfile != null)
        {
            currentProfile.PointsBalance += task.PointValue;
            var token = AuthService.CurrentSession?.AccessToken ?? string.Empty;
            await UserProfileService.SaveProfileAsync(currentProfile, token);
            pointsMessage = $"You earned {task.PointValue} points! Total: {currentProfile.PointsBalance}";
        }
        else
        {
            pointsMessage = string.Empty;
        }
    }

    void ToggleDone(TaskItem task)
    {
        TaskService.ToggleDone(task);
    }

    void DeleteTask(TaskItem task)
    {
        TaskService.RemoveTask(task);
    }

    void StartEdit(TaskItem task)
    {
        editingTask = task;
        tempTask = new TaskItem
        {
            Title = task.Title,
            AssignedTo = task.AssignedTo,
            DueDate = task.DueDate,
            Notes = task.Notes,
            IsDone = task.IsDone
        };
    }

    void SaveEdit()
    {
        if (editingTask != null)
        {
            editingTask.Title = tempTask.Title;
            editingTask.AssignedTo = tempTask.AssignedTo;
            editingTask.DueDate = tempTask.DueDate;
            editingTask.Notes = tempTask.Notes;
            editingTask = null;
        }
    }

    void CancelEdit()
    {
        editingTask = null;
    }

    void StartUpdateNotes(TaskItem task)
    {
        updatingNotesTask = task;
    }

    void SaveNotes()
    {
        updatingNotesTask = null;
    }

    void CancelNotes()
    {
        updatingNotesTask = null;
    }
}