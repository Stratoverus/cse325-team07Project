@page "/dashboard"
@rendermode InteractiveServer

@using System.Linq
@using TaskDone.Services
@using TaskDone.Models

@inject TaskService TaskService
@inject AnnouncementService AnnouncementService
@inject NavigationManager Navigation
@inject SupabaseAuthService AuthService
@inject UserProfileService UserProfileService
@inject RewardService RewardService
@inject Supabase.Client SupabaseClient

<h3>Dashboard</h3>

@if (!AuthService.IsAuthenticated)
{
    <div class="alert alert-warning" role="alert">
        Please <NavLink href="/login?returnUrl=%2Fdashboard">log in</NavLink> to view the dashboard.
    </div>
}
else
{
    <div class="mb-3 d-flex gap-2">
        @if (currentFamilyMember != null && string.Equals(currentFamilyMember.Role, "parent", StringComparison.OrdinalIgnoreCase))
        {
            <NavLink class="btn btn-success" href="@GetAddTaskUrl()">Add New Task</NavLink>
        }
        <NavLink class="btn btn-outline-secondary" href="@GetProfileUrl()">Back to Profile</NavLink>
        <button type="button" class="btn btn-outline-danger" @onclick="HandleLogoutAsync">Logout</button>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="card text-white bg-primary mb-3">
                <div class="card-body">
                    <h5 class="card-title">Total Tasks</h5>
                    <p class="card-text">@visibleTasks.Count()</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-success mb-3">
                <div class="card-body">
                    <h5 class="card-title">Completed Tasks</h5>
                    <p class="card-text">@visibleTasks.Count(t => t.IsDone)</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-warning mb-3">
                <div class="card-body">
                    <h5 class="card-title">Pending Tasks</h5>
                    <p class="card-text">@visibleTasks.Count(t => !t.IsDone)</p>
                </div>
            </div>
        </div>
    </div>

    @if (currentFamilyMember != null)
    {
        <div class="alert alert-info d-flex align-items-center justify-content-between mb-3">
            <span>Points balance: <strong>@(currentFamilyMember.PointsBalance ?? 0) pts</strong></span>
            <NavLink class="btn btn-sm btn-warning" href="rewards">Redeem Points</NavLink>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(pointsMessage))
    {
        <div class="alert alert-success">@pointsMessage</div>
    }

    <h4>Recent Tasks</h4>
    @if (!visibleTasks.Any())
    {
        <div class="alert alert-secondary">No tasks exist for your family yet.</div>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Assigned To</th>
                    <th>Status</th>
                    <th>Due Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var task in visibleTasks.OrderBy(t => t.DueDate))
                {
                    <tr>
                        @if (editingTask == task)
                        {
                            <td><InputText class="form-control" @bind-Value="tempTask.Title" /></td>
                            <td>
                                <InputSelect class="form-select" @bind-Value="tempTask.AssignedToUserId">
                                    <option value="">Select Assignee...</option>
                                    @foreach (var kvp in assigneeNamesMap)
                                    {
                                        <option value="@kvp.Key">@kvp.Value</option>
                                    }
                                </InputSelect>
                            </td>
                            <td>@(task.IsDone ? "Completed" : "Pending")</td>
                            <td><InputDate class="form-control" @bind-Value="tempTask.DueDate" /></td>
                            <td>
                                <button class="btn btn-sm btn-success" @onclick="SaveEdit" disabled="@isSavingEdit">
                                    @if (isSavingEdit)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                    }
                                    Save
                                </button>
                                <button class="btn btn-sm btn-secondary ms-2" @onclick="CancelEdit" disabled="@isSavingEdit">Cancel</button>
                            </td>
                        }
                        else
                        {
                            <td>@task.Title</td>
                            <td>@(task.AssignedToUserId != null && assigneeNamesMap.TryGetValue(task.AssignedToUserId, out var n) ? n : (task.AssignedToUserId ?? "Unassigned"))</td>
                            <td>
                                @if (task.IsDone)
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else if (task.IsAccepted)
                                {
                                    <span class="badge bg-primary">In Progress</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pending</span>
                                }
                            </td>
                            <td>@(task.DueDate?.ToShortDateString() ?? "No due date")</td>
                            <td>
                                @if (!task.IsAccepted)
                                {
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => AcceptTaskAsync(task)" disabled="@(processingTaskId == task.TaskId)">
                                        @if (processingTaskId == task.TaskId)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                        }
                                        Accept
                                    </button>
                                }
                                else if (!task.IsDone)
                                {
                                    <button class="btn btn-sm btn-outline-success" @onclick="() => MarkComplete(task)">Mark Complete</button>
                                    <button class="btn btn-sm btn-outline-warning ms-2" @onclick="() => StartUpdateNotes(task)">Update Notes</button>
                                    <button class="btn btn-sm btn-outline-primary ms-2" @onclick="() => StartEdit(task)">Edit</button>
                                    <button class="btn btn-sm btn-outline-danger ms-2" @onclick="() => DeleteTask(task)">Delete</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleDone(task)">Re-open</button>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (updatingNotesTask != null)
    {
        <div class="card mt-3 border-warning">
            <div class="card-body">
                <h6 class="card-title">Update notes — @updatingNotesTask.Title</h6>
                <textarea class="form-control mb-2" rows="3" @bind="updatingNotesTask.Notes" placeholder="Add a progress note..."></textarea>
                <button class="btn btn-sm btn-warning" @onclick="SaveNotes" disabled="@isSavingNotes">
                    @if (isSavingNotes)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    }
                    Save Notes
                </button>
                <button class="btn btn-sm btn-secondary ms-2" @onclick="CancelNotes" disabled="@isSavingNotes">Cancel</button>
            </div>
        </div>
    }

    <h4 class="mt-4">Announcements</h4>
    @if (announcements.Any())
    {
        <ul class="list-group mb-3">
            @foreach (var announcement in announcements.OrderByDescending(a => a.CreatedAt))
            {
                <li class="list-group-item">
                    <strong>@announcement.DisplayCreatedBy:</strong> @announcement.Message
                    <div class="text-muted small">@announcement.CreatedAt.ToLocalTime().ToString("g")</div>
                </li>
            }
        </ul>
    }
    else
    {
        <div class="alert alert-secondary mb-3">No announcements for your family yet.</div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Post New Announcement</h5>
           
            <div class="mb-3">
                <textarea class="form-control" rows="3" @bind="newAnnouncementMessage" placeholder="Enter your announcement..."></textarea>
            </div>
            <button class="btn btn-primary" @onclick="PostAnnouncement" disabled="@(isPostingAnnouncement || !HasFamily)">Post Announcement</button>
            @if (!string.IsNullOrWhiteSpace(announcementMessage))
            {
                <div class="mt-3 alert @(announcementMessage.StartsWith("Error") ? "alert-danger" : "alert-success")">@announcementMessage</div>
            }
        </div>
    </div>
}

@code {
    private TaskItem? editingTask = null;
    private TaskItem tempTask = new();
    private IEnumerable<TaskItem> visibleTasks = Enumerable.Empty<TaskItem>();
    private TaskItem? updatingNotesTask = null;
    private UserProfile? currentProfile = null;
    private string pointsMessage = string.Empty;
    private string announcementMessage = string.Empty;
    private string newAnnouncementMessage = string.Empty;
    private bool isPostingAnnouncement = false;
    private string processingTaskId = string.Empty;
    private bool isSavingNotes = false;
    private bool isSavingEdit = false;
    private List<Announcement> announcements = new();
    private string familyId = string.Empty;
    private FamilyMember? currentFamilyMember = null;
    private string? requestedFamilyId;
    private Dictionary<string, string> assigneeNamesMap = new();

    protected override async Task OnParametersSetAsync()
    {
        await AuthService.EnsureSessionRestoredAsync();

        requestedFamilyId = GetRequestedFamilyId();

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        if (!AuthService.IsAuthenticated || string.IsNullOrWhiteSpace(AuthService.CurrentUserId))
        {
            visibleTasks = Enumerable.Empty<TaskItem>();
            announcements = new List<Announcement>();
            currentProfile = null;
            familyId = string.Empty;
            return;
        }

        var userId = AuthService.CurrentUserId;
        var token = AuthService.CurrentSession?.AccessToken ?? string.Empty;

        if (!string.IsNullOrWhiteSpace(token))
        {
            try { await SupabaseClient.Auth.SetSession(token, AuthService.CurrentSession?.RefreshToken ?? string.Empty); } catch { }
        }

        currentProfile = await UserProfileService.GetProfileAsync(userId, token);
        var memberships = await RewardService.GetFamilyMembershipsAsync(userId, token);

        FamilyMember? selectedMembership = null;
        if (!string.IsNullOrWhiteSpace(requestedFamilyId))
        {
            selectedMembership = memberships.FirstOrDefault(m =>
                string.Equals(m.FamilyId, requestedFamilyId, StringComparison.Ordinal));
        }

        selectedMembership ??= memberships
            .OrderByDescending(m => m.JoinedAt)
            .FirstOrDefault();

        currentFamilyMember = selectedMembership;
        familyId = selectedMembership?.FamilyId ?? string.Empty;

        if (string.IsNullOrWhiteSpace(familyId))
        {
            visibleTasks = Enumerable.Empty<TaskItem>();
            announcements = new List<Announcement>();
            assigneeNamesMap.Clear();
            return;
        }

        try 
        {
            var result = await SupabaseClient.From<TaskItem>().Where(x => x.FamilyId == familyId).Get();
            visibleTasks = result.Models;
        } 
        catch 
        {
            visibleTasks = new List<TaskItem>();
        }
        announcements = await AnnouncementService.GetAnnouncementsByFamilyIdAsync(familyId, token);

        var familyMemberships = await RewardService.GetFamilyMembershipsByFamilyIdAsync(familyId, token);
        assigneeNamesMap.Clear();
        foreach(var member in familyMemberships)
        {
            if(!string.IsNullOrWhiteSpace(member.UserId))
            {
                var profile = await UserProfileService.GetProfileAsync(member.UserId, token);
                var displayName = profile is null
                    ? member.UserId
                    : !string.IsNullOrWhiteSpace(profile.PreferredDisplayName)
                        ? profile.PreferredDisplayName
                        : !string.IsNullOrWhiteSpace(profile.FullName)
                            ? profile.FullName
                            : profile.Email;
                assigneeNamesMap[member.UserId] = displayName;
            }
        }
    }

    private async Task AcceptTaskAsync(TaskItem task)
    {
        if (task == null) return;
        
        processingTaskId = task.TaskId;
        
        try
        {
            await SupabaseClient.From<TaskItem>()
                .Where(x => x.TaskId == task.TaskId)
                .Set(x => x.IsAccepted, true)
                .Update();
                
            task.IsAccepted = true;
            TaskService.UpdateTask(task);
            pointsMessage = string.Empty;
        }
        catch (Exception ex)
        {
            pointsMessage = $"Error accepting task: {ex.Message}";
        }
        
        await LoadDataAsync();
        processingTaskId = string.Empty;
    }

    private async Task MarkComplete(TaskItem task)
    {
        if (task == null)
            return;

        task.IsDone = true;
        try
        {
            await SupabaseClient.From<TaskItem>()
                .Where(x => x.TaskId == task.TaskId)
                .Set(x => x.IsDone, true)
                .Set(x => x.UpdatedAt, DateTime.UtcNow)
                .Update();
        }
        catch(Exception) {}

        if (task.IsDone && currentFamilyMember != null)
        {
            var pointValue = task.PointValue ?? 0;
            var updatedPoints = (currentFamilyMember.PointsBalance ?? 0) + pointValue;
            currentFamilyMember.PointsBalance = updatedPoints;
            await RewardService.UpdatePointsAsync(currentFamilyMember.FamilyMemberId, updatedPoints, AuthService.CurrentSession?.AccessToken ?? string.Empty);
            pointsMessage = $"You earned {pointValue} points! Total: {updatedPoints}";
        }
        else
        {
            pointsMessage = string.Empty;
        }

        await LoadDataAsync();
    }

    private async Task ToggleDone(TaskItem task)
    {
        if (task == null)
            return;

        task.IsDone = !task.IsDone;
        try
        {
            await SupabaseClient.From<TaskItem>()
                .Where(x => x.TaskId == task.TaskId)
                .Set(x => x.IsDone, task.IsDone)
                .Set(x => x.UpdatedAt, DateTime.UtcNow)
                .Update();
        }
        catch(Exception) {}
        
        pointsMessage = string.Empty;
        await LoadDataAsync();
    }

    private async Task DeleteTask(TaskItem task)
    {
        if (task == null)
            return;

        try
        {
            await SupabaseClient.From<TaskItem>()
                .Where(x => x.TaskId == task.TaskId)
                .Delete();
        }
        catch (Exception) {}
        
        await LoadDataAsync();
    }

    private void StartEdit(TaskItem task)
    {
        editingTask = task;
        tempTask = new TaskItem
        {
            TaskId = task.TaskId,
            FamilyId = task.FamilyId,
            Title = task.Title,
            AssignedToUserId = task.AssignedToUserId,
            DueDate = task.DueDate,
            Notes = task.Notes,
            IsDone = task.IsDone
        };
    }

    private async Task SaveEdit()
    {
        if (editingTask == null)
            return;

        isSavingEdit = true;
        editingTask.Title = tempTask.Title;
        editingTask.AssignedToUserId = tempTask.AssignedToUserId;
        editingTask.DueDate = tempTask.DueDate;
        editingTask.Notes = tempTask.Notes;
        editingTask.IsDone = tempTask.IsDone;
        editingTask.UpdatedAt = DateTime.UtcNow;

        try
        {
            await SupabaseClient.From<TaskItem>().Update(editingTask);
        }
        catch (Exception) {}

        editingTask = null;
        await LoadDataAsync();
        isSavingEdit = false;
    }

    private void CancelEdit()
    {
        editingTask = null;
    }

    private void StartUpdateNotes(TaskItem task)
    {
        updatingNotesTask = task;
    }

    private async Task SaveNotes()
    {
        if (updatingNotesTask == null)
            return;

        isSavingNotes = true;

        updatingNotesTask.UpdatedAt = DateTime.UtcNow;
        try
        {
            await SupabaseClient.From<TaskItem>().Update(updatingNotesTask);
        }
        catch (Exception) {}

        updatingNotesTask = null;
        await LoadDataAsync();
        isSavingNotes = false;
    }

    private void CancelNotes()
    {
        updatingNotesTask = null;
    }

    private bool HasFamily => !string.IsNullOrWhiteSpace(familyId);

    private async Task PostAnnouncement()
    {
        if (isPostingAnnouncement)
            return;

        announcementMessage = string.Empty;

        if (!HasFamily)
        {
            announcementMessage = "Error: You must be assigned to a family before posting announcements. Please update Family Settings.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newAnnouncementMessage))
        {
            announcementMessage = "Error: Announcement message cannot be empty.";
            return;
        }

        if (!HasFamily || string.IsNullOrWhiteSpace(AuthService.CurrentUserId))
        {
            announcementMessage = "Error: You must be assigned to a family before posting announcements.";
            return;
        }

        var currentFamilyId = familyId;
        isPostingAnnouncement = true;
        try
        {
            var announcement = new Announcement
            {
                FamilyId = currentFamilyId,
                Message = newAnnouncementMessage.Trim(),
                CreatedBy = AuthService.CurrentUserId,
                AnnouncementId = Guid.NewGuid().ToString(),
                CreatedAt = DateTime.UtcNow
            };

            await AnnouncementService.CreateAnnouncementAsync(announcement, AuthService.CurrentSession?.AccessToken ?? string.Empty);
            announcementMessage = "Announcement posted successfully.";
            newAnnouncementMessage = string.Empty;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            announcementMessage = $"Error posting announcement: {ex.Message}";
        }
        finally
        {
            isPostingAnnouncement = false;
        }
    }

    private async Task HandleLogoutAsync()
    {
        await AuthService.SignOutAsync();
        Navigation.NavigateTo("/login", forceLoad: false);
    }

    private string? GetRequestedFamilyId()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (!query.TryGetValue("familyId", out var value) || string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        return value.ToString();
    }

    private string GetAddTaskUrl()
    {
        if (string.IsNullOrWhiteSpace(familyId))
        {
            return "/add-task";
        }

        return $"/add-task?familyId={Uri.EscapeDataString(familyId)}";
    }

    private string GetProfileUrl()
    {
        var userId = AuthService.CurrentUserId;
        return string.IsNullOrWhiteSpace(userId) ? "/profile" : $"/profile/{userId}";
    }
}
