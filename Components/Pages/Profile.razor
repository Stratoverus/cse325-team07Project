@page "/profile"
@page "/profile/{UserId}"
@rendermode InteractiveServer
@inject TaskDone.Services.SupabaseAuthService AuthService
@inject TaskDone.Services.UserProfileService ProfileService
@inject NavigationManager Navigation
@inject Supabase.Client SupabaseClient

<PageTitle>Profile</PageTitle>

<h3>Your Profile</h3>

<ErrorBoundary>
    <ChildContent>
        @if (!AuthService.IsAuthenticated)
        {
            <div class="alert alert-warning" role="alert">
                Please <NavLink href="@GetLoginLink()">log in</NavLink> to view your profile.
            </div>
        }
        else if (!isLoaded)
        {
            <p>Loading your profile...</p>
        }
        else if (!string.IsNullOrWhiteSpace(loadError))
        {
            <div class="alert alert-danger" role="alert">
                @loadError
            </div>
        }
        else if (!isAuthorizedForRoute)
        {
            <div class="alert alert-danger" role="alert">
                You are not authorized to view this profile.
            </div>
        }
        else if (profile is null)
        {
            <div class="alert alert-warning" role="alert">
                We could not load your profile details yet. Please refresh the page.
            </div>
        }
        else if (!profile.IsFirstLoginComplete)
        {
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Welcome to TaskDone</h5>
                    <p class="text-muted mb-4">Let's set up your profile so your family workspace is ready.</p>

                    <EditForm Model="profile" OnValidSubmit="SaveProfileAsync" FormName="FirstLoginProfileForm">
                        <DataAnnotationsValidator />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Full Name</label>
                                <InputText class="form-control" @bind-Value="profile.FullName" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Preferred Display Name</label>
                                <InputText class="form-control" @bind-Value="profile.PreferredDisplayName" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Age</label>
                                <InputNumber class="form-control" @bind-Value="profile.Age" />
                            </div>

                            <div class="col-md-8">
                                <label class="form-label">Time Zone</label>
                                <InputSelect class="form-select" @bind-Value="profile.TimeZone">
                                    @foreach (var tz in timeZoneOptions)
                                    {
                                        <option value="@tz.Id">@tz.Label</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary">Save Profile</button>
                        </div>
                    </EditForm>

                    @if (!string.IsNullOrWhiteSpace(profileMessage))
                    {
                        <p class="mt-3 text-success">@profileMessage</p>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="d-grid gap-3">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h5 class="card-title mb-1">Welcome, @GetWelcomeName()</h5>
                                <p class="text-muted mb-0">Manage your account and family workspace from here.</p>
                            </div>
                            <NavLink class="btn btn-outline-secondary btn-sm" href="/account-settings">
                                Account Settings
                            </NavLink>
                        </div>

                        <hr />

                        <div class="row">
                            <div class="col-md-6">
                                <p class="mb-1"><strong>Email:</strong> @profile.Email</p>
                                <p class="mb-1"><strong>Display Name:</strong> @GetWelcomeName()</p>
                                <p class="mb-0"><strong>Time Zone:</strong> @profile.TimeZone</p>
                            </div>
                            <div class="col-md-6">
                                <p class="mb-0"><strong>Age:</strong> @(profile.Age?.ToString() ?? "Not set")</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm">
                    <div class="card-body text-center">
                        <h5 class="card-title">Family Setup</h5>
                        <p class="text-muted">Start by creating your family or joining one you've been invited to.</p>
                        <div class="d-flex justify-content-center gap-2">
                            <button type="button" class="btn btn-primary" @onclick="OpenCreateFamForm">Create a Family</button>
                            <button type="button" class="btn btn-outline-primary" @onclick="OpenModal">Join a Family</button>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(familyMessage))
                        {
                            <p class="mt-3 text-muted">@familyMessage</p>
                        }
                    </div>
                </div>

                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Getting Started</h5>
                        <ul class="mb-0">
                            <li>Create or join your family group.</li>
                            <li>Add your first household tasks.</li>
                            <li>Invite the other parent and your kids.</li>
                        </ul>
                    </div>
                </div>
            </div>
        }
    </ChildContent>
    <ErrorContent Context="ex">
        <div class="alert alert-danger" role="alert">
            Profile page failed to render: @ex.Message
        </div>
    </ErrorContent>
</ErrorBoundary>

@* Join a Family Modal *@

@if (showModal)
{
    <div class="modal fade show" style="display: block; background: rgba(0,0,0,0.5);" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                
                <div class="modal-header">
                    <h5 class="modal-title">Join a Family</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <p>Enter the 6-character code to join a family.</p>
                    
                    <input type="text"
                           class="form-control"
                           placeholder="e.g. A3K9MZ"
                           maxlength="6"
                           @bind="joinFamilyCode"
                           @bind:event="oninput" />

                    @if (!string.IsNullOrWhiteSpace(joinFamilyMessage))
                    {
                        <div class="mt-2 text-danger">
                            <small>@joinFamilyMessage</small>
                        </div>
                    }
                </div>

                <div class="modal-footer">
                    <button type="button" 
                            class="btn btn-secondary" 
                            @onclick="CloseModal">
                        Close
                    </button>
                    
                    <button type="button" 
                            class="btn btn-primary"
                            @onclick="HandleJoinFamilyAsync"
                            disabled="@(isJoiningFamily || string.IsNullOrEmpty(joinFamilyCode))">
                        
                        @if (isJoiningFamily)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span> Joining...</span>
                        }
                        else
                        {
                            <span>Join Family</span>
                        }
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@* Create a Family Form *@

@if (showCreateFamForm) {
    <div class="modal fade show" style="display: block; background: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content shadow-lg">
                <div class="modal-header">
                    <h5 class="modal-title">Create a Family</h5>
                    <button type="button" class="btn-close" @onclick="CloseCreateFamForm"></button>
                </div>
                
                <EditForm Model="newFamily" OnValidSubmit="HandleCreateFamilyAsync">
                    <div class="modal-body">
                        <p class="text-muted">Set up a new family group.</p>
                        <div class="mb-3">
                            <label class="form-label font-weight-bold">Family Name</label>

                            <InputText class="form-control" @bind-Value="newFamily.FamilyName" placeholder="e.g. The Smith Family" />
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseCreateFamForm">Cancel</button>

                        <button type="submit" class="btn btn-success" disabled="@isCreatingFamily">
                            @if (isCreatingFamily) {
                                <span class="spinner-border spinner-border-sm"></span>
                                <span> Creating...</span>
                            } else {
                                <span>Create Family</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? UserId { get; set; }

    private TaskDone.Models.UserProfile? profile;
    private bool isLoaded;
    private bool isAuthorizedForRoute;
    private string profileMessage = string.Empty;
    private string familyMessage = string.Empty;
    private string loadError = string.Empty;
    private readonly IReadOnlyList<TimeZoneOption> timeZoneOptions = BuildTimeZoneOptions();

    private bool showModal = false;
    private void OpenModal() => showModal = true;
    private void CloseModal() => showModal = false;
    private bool showCreateFamForm = false;
    private void OpenCreateFamForm() => showCreateFamForm = true;
    private void CloseCreateFamForm() => showCreateFamForm = false;

    private TaskDone.Models.Family newFamily = new();
    private bool isCreatingFamily = false;

    private string joinFamilyCode = string.Empty;
    private string joinFamilyMessage = string.Empty;
    private bool isJoiningFamily = false;

    protected override async Task OnParametersSetAsync()
    {
        loadError = string.Empty;
        isLoaded = false;

        try
        {
            var currentUserId = AuthService.CurrentUserId;
            var currentEmail = AuthService.CurrentUserEmail ?? string.Empty;
            var accessToken = AuthService.CurrentSession?.AccessToken;
            var routeUserId = string.IsNullOrWhiteSpace(UserId) ? currentUserId : UserId;

            isAuthorizedForRoute = !string.IsNullOrWhiteSpace(currentUserId) &&
                string.Equals(routeUserId, currentUserId, StringComparison.Ordinal);

            if (isAuthorizedForRoute && !string.IsNullOrWhiteSpace(currentUserId) && !string.IsNullOrWhiteSpace(accessToken))
            {
                profile = await ProfileService.EnsureDraftProfileAsync(currentUserId, currentEmail, accessToken);
            }
            else
            {
                profile = null;
            }
        }
        catch (Exception ex)
        {
            profile = null;
            isAuthorizedForRoute = false;
            loadError = $"Profile failed to load: {ex.Message}";
        }

        isLoaded = true;
    }

    private async Task SaveProfileAsync()
    {
        if (profile is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(profile.FullName))
        {
            profileMessage = "Please add your full name before saving.";
            return;
        }

        if (string.IsNullOrWhiteSpace(profile.PreferredDisplayName))
        {
            profile.PreferredDisplayName = profile.FullName;
        }

        if (string.IsNullOrWhiteSpace(profile.TimeZone))
        {
            profile.TimeZone = TimeZoneInfo.Local.Id;
        }

        profile.IsFirstLoginComplete = true;
        var accessToken = AuthService.CurrentSession?.AccessToken;
        if (string.IsNullOrWhiteSpace(accessToken))
        {
            profileMessage = "Your session expired. Please log in again.";
            return;
        }

        profile = await ProfileService.SaveProfileAsync(profile, accessToken);
        profileMessage = "Profile saved. You are ready to set up your family.";
    }

    private void ShowCreateFamilyPlaceholder()
    {
        familyMessage = "Family creation will be available from this section.";
    }

    private void ShowJoinFamilyPlaceholder()
    {
        familyMessage = "Family invite and join options will appear here.";
    }

    private string GetWelcomeName()
    {
        if (profile is null)
        {
            return "there";
        }

        if (!string.IsNullOrWhiteSpace(profile.PreferredDisplayName))
        {
            return profile.PreferredDisplayName;
        }

        if (!string.IsNullOrWhiteSpace(profile.FullName))
        {
            return profile.FullName;
        }

        return profile.Email;
    }

    private string GetLoginLink()
    {
        var uri = Navigation.ToBaseRelativePath(Navigation.Uri);
        var returnUrl = string.IsNullOrWhiteSpace(uri) ? "/profile" : $"/{uri}";
        return $"/login?returnUrl={Uri.EscapeDataString(returnUrl)}";
    }

    private static IReadOnlyList<TimeZoneOption> BuildTimeZoneOptions()
    {
        var nowUtc = DateTime.UtcNow;

        return TimeZoneInfo.GetSystemTimeZones()
            .Select(tz =>
            {
                var offset = tz.GetUtcOffset(nowUtc);
                var sign = offset < TimeSpan.Zero ? "-" : "+";
                var absolute = offset.Duration();
                var label = $"(UTC{sign}{absolute.Hours:D2}:{absolute.Minutes:D2}) {tz.DisplayName}";

                return new TimeZoneOption(tz.Id, label);
            })
            .OrderBy(x => x.Label)
            .ToList();
    }

    private sealed record TimeZoneOption(string Id, string Label);

    private async Task HandleCreateFamilyAsync()
    {
        if (string.IsNullOrWhiteSpace(newFamily.FamilyName))
        {
            familyMessage = "Please enter a family name.";
            return;
        }

        isCreatingFamily = true;
        try
        {
            var currentUserId = AuthService.CurrentUserId;

            if (!string.IsNullOrWhiteSpace(currentUserId))
            {
                newFamily.CreatedBy = currentUserId;
                newFamily.FamilyCode = GenerateFamilyCode();
                newFamily.CreatedAt = DateTime.UtcNow;
                newFamily.UpdatedAt = DateTime.UtcNow;

                var familyResponse = await SupabaseClient
                    .From<TaskDone.Models.Family>()
                    .Insert(newFamily);

                var createdFamily = familyResponse.Models.FirstOrDefault();

                if (createdFamily is null)
                {
                    familyMessage = "Error: Family was not created correctly.";
                    return;
                }

                var member = new TaskDone.Models.FamilyMember
                {
                    FamilyId  = createdFamily.FamilyId,
                    UserId    = currentUserId,
                    Role      = "parent",
                    JoinedAt  = createdFamily.CreatedAt
                };

                await SupabaseClient
                    .From<TaskDone.Models.FamilyMember>()
                    .Insert(member);

                familyMessage = $"Family '{newFamily.FamilyName}' created successfully!";
                newFamily = new();
                CloseCreateFamForm();
                Navigation.NavigateTo("/dashboard");
            }
        }
        catch (Exception ex)
        {
            familyMessage = $"Error creating family: {ex.Message}";
        }
        finally
        {
            isCreatingFamily = false;
        }
    }

        private static string GenerateFamilyCode()
    {
        const string chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
        var random = new Random();
        return new string(Enumerable.Range(0, 6)
            .Select(_ => chars[random.Next(chars.Length)])
            .ToArray());
    }

        private async Task HandleJoinFamilyAsync()
    {
        if (string.IsNullOrWhiteSpace(joinFamilyCode))
        {
            joinFamilyMessage = "Please enter a family code.";
            return;
        }

        isJoiningFamily = true;
        joinFamilyMessage = string.Empty;

        try
        {
            var currentUserId = AuthService.CurrentUserId;

            if (string.IsNullOrWhiteSpace(currentUserId))
            {
                joinFamilyMessage = "You must be logged in to join a family.";
                return;
            }

            var familyResponse = await SupabaseClient
                .From<TaskDone.Models.Family>()
                .Filter("family_code", Postgrest.Constants.Operator.Equals, joinFamilyCode.Trim().ToUpper())
                .Get();

            var family = familyResponse.Models.FirstOrDefault();

            if (family is null)
            {
                joinFamilyMessage = "No family found with that code. Please check and try again.";
                return;
            }

            var existingResponse = await SupabaseClient
                .From<TaskDone.Models.FamilyMember>()
                .Filter("family_id", Postgrest.Constants.Operator.Equals, family.FamilyId)
                .Filter("user_id", Postgrest.Constants.Operator.Equals, currentUserId)
                .Get();

            if (existingResponse.Models.Any())
            {
                joinFamilyMessage = "You are already a member of this family.";
                return;
            }

            var member = new TaskDone.Models.FamilyMember
            {
                FamilyId = family.FamilyId,
                UserId   = currentUserId,
                Role     = "child",
                JoinedAt = DateTime.UtcNow
            };

            await SupabaseClient
                .From<TaskDone.Models.FamilyMember>()
                .Insert(member);

            CloseModal();
            Navigation.NavigateTo("/dashboard");
        }
        catch (Exception ex)
        {
            joinFamilyMessage = $"Error joining family: {ex.Message}";
        }
        finally
        {
            isJoiningFamily = false;
        }
    }


}
